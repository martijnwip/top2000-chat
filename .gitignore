# Buiten git om de omvang: samen 629 MB, en GitHub weigert bestanden boven
# 100 MB. Deze bestanden komen uit het eerdere ophaal- en verrijkingsproject;
# de scripts die ze maakten horen niet in deze repo. Ze zijn hier dus niet
# opnieuw te bouwen -- wie deze repo kloont, moet ze apart aanleveren.
# Handgemaakte data en meetlatten staan wel in git.

# 48 MB
top2000.db

# 31 MB en 5,4 MB
data/corpus_songs.jsonl
data/corpus_artiesten.jsonl

# 277 MB; chunks en bge-m3-vectoren
data/rag_index.db

# Caches van externe API's, samen 314 MB. Buiten git houden, maar niet
# weggooien: opnieuw ophalen kost duizenden verzoeken aan MusicBrainz en
# Wikidata.
data/mb_cache/
data/wikidata_cache/

# Ruwe download van de bronlijst; het geparste resultaat staat in
# data/top2000.csv en dat zit wel in git
data/top2000.html

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/

# Systeem en editor
.DS_Store
.idea/
.vscode/
